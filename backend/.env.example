# ---------------------------------------------------------------------------
# RateFlow backend — copy to `.env` and fill in real values.
# Every value below is a placeholder; nothing here is a real credential.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of origins allowed to call the API (dashboard origin).
CORS_ORIGIN=http://localhost:3000

# --- Redis ----------------------------------------------------------------
# Either supply a full URL...
REDIS_URL=redis://localhost:6379
# ...or the discrete parts (REDIS_URL wins when both are present).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
# Prefix applied to every key RateFlow writes.
REDIS_KEY_PREFIX=rateflow

# --- Rate limiting behaviour ----------------------------------------------
# Policy applied when a route does not name one explicitly.
DEFAULT_POLICY=default
# open  -> allow traffic through when Redis is unreachable
# closed-> reject traffic when Redis is unreachable
FAILURE_MODE=open
# Seconds of idle time before an unused bucket is evicted.
BUCKET_TTL_SECONDS=3600

# --- Metrics --------------------------------------------------------------
# Seconds of per-second throughput history retained for the dashboard.
METRICS_WINDOW_SECONDS=120
METRICS_TTL_SECONDS=300

# --- Credentials (placeholders — replace before deploying) ----------------
# Token required by the /api/admin/* maintenance endpoints.
ADMIN_TOKEN=replace-me-admin-token
# Shared secret the dashboard sends on /api/metrics/* requests.
DASHBOARD_API_KEY=replace-me-dashboard-key
# Set to false to leave the metrics API open during local development.
REQUIRE_API_KEY=false
