# ---------------------------------------------------------------------------
# Root environment for docker-compose. Copy to `.env` and fill in real values.
# Placeholders only — no real credentials belong in this file or in git.
# ---------------------------------------------------------------------------

# --- Ports published on the host ------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=4000
REDIS_PORT=6379

# --- Redis ----------------------------------------------------------------
# Leave empty for no auth (local development only). When set, compose starts
# Redis with --requirepass and wires the same value into the backend URL.
REDIS_PASSWORD=
REDIS_KEY_PREFIX=rateflow

# --- Rate limiting --------------------------------------------------------
# Where req.ip comes from, and therefore what the limiter buckets on.
#   0 / false  no proxy in front — use the socket address (correct locally)
#   1          exactly one reverse proxy (nginx, Caddy, an ALB) sets XFF
# Never `true`: that trusts a client-supplied X-Forwarded-For, which lets any
# caller mint a fresh bucket per request and defeats the limiter outright.
TRUST_PROXY=0

DEFAULT_POLICY=default
# open  -> serve traffic if Redis is unreachable
# closed-> reject traffic if Redis is unreachable
FAILURE_MODE=open
BUCKET_TTL_SECONDS=3600

# --- Override ceilings ----------------------------------------------------
# The dashboard can retune limits live; these cap how far it can go. Without a
# ceiling an override is an off switch for the limiter, and on a public
# dashboard that switch is reachable by anyone.
POLICY_MAX_CAPACITY=10000
POLICY_MAX_REFILL_RATE=1000
POLICY_MAX_COST=100

# --- Metrics --------------------------------------------------------------
METRICS_WINDOW_SECONDS=120
METRICS_TTL_SECONDS=300

# --- Credentials (replace before deploying) -------------------------------
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=replace-me-admin-token
DASHBOARD_API_KEY=replace-me-dashboard-key
REQUIRE_API_KEY=true
ALLOW_ADMIN_PROXY=true

# --- Frontend -------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_POLL_INTERVAL_MS=10000
LOG_LEVEL=info
