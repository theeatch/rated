# ---------------------------------------------------------------------------
# RateFlow dashboard — copy to `.env.local`. Placeholders only.
# ---------------------------------------------------------------------------

# Server-side base URL used by the /api/proxy route handler.
# Inside docker-compose this is the service name; locally it is localhost.
BACKEND_URL=http://localhost:4000

# Sent as `x-api-key` by the proxy. Must match DASHBOARD_API_KEY in the backend.
# Stays server-side — never exposed to the browser.
DASHBOARD_API_KEY=replace-me-dashboard-key

# Sent as `Authorization: Bearer …` for admin actions (policy edits, resets).
ADMIN_TOKEN=replace-me-admin-token

# Set to false to make the proxy refuse to forward admin/mutating requests.
ALLOW_ADMIN_PROXY=true

# Public base URL the browser uses for the traffic generator, so simulated
# requests get real per-client-IP buckets instead of sharing the Next server's.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Dashboard poll interval in milliseconds.
NEXT_PUBLIC_POLL_INTERVAL_MS=2000
